<?xml version="1.0" encoding="utf-8"?>
<!--
  Memora stores sensitive, local-only source references and derived data. Backup and
  device transfer are not an approved product capability. These exclusions protect
  Android 11 and lower; Android 12+ uses data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
